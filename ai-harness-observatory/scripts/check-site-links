#!/usr/bin/env python3

from __future__ import annotations

import re
import sys
from pathlib import Path
from urllib.parse import unquote, urlparse


ROOT = Path(__file__).resolve().parent.parent
SITE_DIR = ROOT / "site"
HREF_RE = re.compile(r'href="([^"]+)"')


def iter_html_files() -> list[Path]:
    return sorted(SITE_DIR.rglob("*.html"))


def normalize_target(source: Path, href: str) -> tuple[Path | None, str | None]:
    parsed = urlparse(href)
    if parsed.scheme or parsed.netloc:
        return None, None
    if href.startswith("#"):
        return source, href[1:] or None

    path_part = unquote(parsed.path)
    if not path_part:
        return source, parsed.fragment or None

    target = (source.parent / path_part).resolve()
    return target, parsed.fragment or None


def anchor_exists(target: Path, fragment: str) -> bool:
    if not target.exists():
        return False
    text = target.read_text(encoding="utf-8")
    return (
        f'id="{fragment}"' in text
        or f"id='{fragment}'" in text
        or f'name="{fragment}"' in text
        or f"name='{fragment}'" in text
    )


def check_file(path: Path) -> list[str]:
    errors: list[str] = []
    text = path.read_text(encoding="utf-8")
    for href in HREF_RE.findall(text):
        target, fragment = normalize_target(path, href)
        if target is None:
            continue
        if not target.exists():
            errors.append(f"missing target for href '{href}'")
            continue
        if fragment and not anchor_exists(target, fragment):
            errors.append(f"missing fragment '#{fragment}' for href '{href}'")
    return errors


def main() -> int:
    if not SITE_DIR.exists():
        print("site/ does not exist", file=sys.stderr)
        return 1

    failed = False
    for path in iter_html_files():
        errors = check_file(path)
        rel = path.relative_to(ROOT)
        if errors:
            failed = True
            print(f"[FAIL] {rel}")
            for error in errors:
                print(f"  - {error}")
        else:
            print(f"[OK]   {rel}")
    return 1 if failed else 0


if __name__ == "__main__":
    raise SystemExit(main())
