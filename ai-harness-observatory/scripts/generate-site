ENTRY_EXPLORATION_ALIASES = {
    ("primary_substrate", "context"): ["context-as-substrate"],
    ("primary_substrate", "teams"): ["teams-as-agency"],
    ("primary_substrate", "sandbox"): ["sandbox-as-agent-body"],
}


def note_output_href(note_path: str) -> str:
    path = Path(note_path).relative_to("notes")
    return str(Path("notes") / path.with_suffix(".html"))


def load_markdown_note(note_path: str) -> dict:
    source_path = ROOT / note_path
    raw_text = source_path.read_text(encoding="utf-8")
    metadata: dict = {}
    body = raw_text
    if raw_text.startswith("---\n"):
        parts = raw_text.split("\n---\n", 1)
        if len(parts) == 2:
            _, remainder = parts
            frontmatter_raw = parts[0][4:]
            loaded = yaml.safe_load(frontmatter_raw) or {}
            if isinstance(loaded, dict):
                metadata = loaded
            body = remainder
    first_heading = re.search(r"^#\s+(.+)$", body, flags=re.MULTILINE)
    title = str(metadata.get("title", "")).strip() or source_path.stem
    if first_heading:
        title = first_heading.group(1).strip()
    note_id = str(metadata.get("id", "")).strip() or source_path.stem
    return {
        "id": note_id,
        "path": note_path,
        "source_path": source_path,
        "output_href": note_output_href(note_path),
        "metadata": metadata,
        "body": body,
        "title": title,
        "section": "/".join(source_path.relative_to(NOTES_DIR).parts[:-1]),
    }


def strip_first_heading(markdown_text: str) -> str:
    return re.sub(r"^#\s+.+\n+", "", markdown_text, count=1, flags=re.MULTILINE)


def extract_wikilinks(markdown_text: str) -> list[str]:
    return re.findall(r"\[\[([^\]]+)\]\]", markdown_text)


def exploration_kind_label(exploration: dict) -> str:
    kind = str(exploration.get("metadata", {}).get("kind", "")).strip()
    return {
        "concept": "Explorations",
        "historical": "Historical Notes",
        "tension": "Tensions",
    }.get(kind, "Explorations")


def note_link_label(note_path: str) -> str:
    return load_markdown_note(note_path)["title"]


def relative_site_href(from_output_href: str, to_output_href: str) -> str:
    from_dir = ROOT / "site" / Path(from_output_href).parent
    to_path = ROOT / "site" / Path(to_output_href)
    return os.path.relpath(to_path, from_dir).replace(os.sep, "/")


def render_named_links(links: list[tuple[str, str]]) -> str:
    if not links:
        return '<p class="empty-state">None linked yet.</p>'
    items = "".join(
        f'<li><a href="{escape(href)}">{escape(label)}</a></li>'
        for label, href in links
    )
    return f"<ul>{items}</ul>"


def load_explorations() -> list[dict]:
    explorations = []
    exploration_root = NOTES_DIR / "explorations"
    if not exploration_root.exists():
        return explorations
    for path in sorted(exploration_root.rglob("*.md")):
        relative = path.relative_to(ROOT)
        if ".gitkeep" in relative.parts:
            continue
        note = load_markdown_note(str(relative))
        note["concept_links"] = extract_wikilinks(note["body"])
        explorations.append(note)
    return explorations


def load_note_registry(explorations: list[dict]) -> dict[str, dict]:
    registry: dict[str, dict] = {note["id"]: note for note in explorations}
    for paths in MORE_STUFF.values():
        for note_path in paths:
            note = load_markdown_note(note_path)
            registry.setdefault(note["id"], note)
    return registry


def load_records() -> list[dict]:
    records = []
    for path in sorted(HARNESS_DIR.glob("*.yaml")):
        if path.name.startswith("_"):
            continue
        with path.open("r", encoding="utf-8") as handle:
            data = yaml.safe_load(handle) or {}
        if isinstance(data, dict):
            records.append(data)
    return records


def load_concepts() -> dict[str, dict]:
    concepts: dict[str, dict] = {}
    for path in sorted(CONCEPT_DIR.glob("*.yaml")):
        if path.name.startswith("_") or path.name == ".gitkeep":
            continue
        with path.open("r", encoding="utf-8") as handle:
            data = yaml.safe_load(handle) or {}
        if isinstance(data, dict) and "id" in data:
            concepts[str(data["id"])] = data
    return concepts


def load_relationships() -> list[dict]:
    with RELATIONSHIPS_PATH.open("r", encoding="utf-8") as handle:
        data = yaml.safe_load(handle) or {}
    relationships = data.get("relationships", [])
    return [item for item in relationships if isinstance(item, dict)]


def slug_to_label(value: str) -> str:
    return value.replace("-", " ").title()


def index_output_href() -> str:
    return "index.html"


def concept_output_href(concept_id: str) -> str:
    return f"concepts/{concept_id}.html"


def harness_anchor(record: dict) -> str:
    return escape(str(record.get("id", "")))


def harness_site_href(from_output_href: str, harness_id: str) -> str:
    return f"{relative_site_href(from_output_href, index_output_href())}#{quote(harness_id)}"


def concept_site_href(from_output_href: str, concept_id: str) -> str:
    return relative_site_href(from_output_href, concept_output_href(concept_id))


def browse_index_output_href(field_key: str) -> str:
    return f"browse/{BROWSE_FIELDS[field_key]['slug']}/index.html"


def slugify(value: str) -> str:
    slug = re.sub(r"[^a-z0-9]+", "-", value.lower()).strip("-")
    return slug or "item"


def render_harness_links(records: list[dict], current_output_href: str) -> str:
    if not records:
        return "<p class=\"empty-state\">None yet.</p>"
    items = []
    for record in records:
        name = escape(str(record.get("name", "Unknown")))
        href = harness_site_href(current_output_href, str(record.get("id", "")))
        items.append(f'<li><a href="{href}">{name}</a></li>')
    return f"<ul>{''.join(items)}</ul>"


def render_link_list(items: list[tuple[str, str]]) -> str:
    if not items:
        return "<p class=\"empty-state\">None yet.</p>"
    rendered = "".join(
        f'<li><a href="{href}">{escape(label)}</a></li>' for label, href in items
    )
    return f"<ul>{rendered}</ul>"


def top_related_harnesses(
    current: dict, records: list[dict], field_name: str, limit: int = 4
) -> list[dict]:
    current_values = set(str(value) for value in current.get(field_name, []))
    matches: list[tuple[int, str, dict]] = []
    for record in records:
        if record.get("id") == current.get("id"):
            continue
        other_values = set(str(value) for value in record.get(field_name, []))
        overlap = len(current_values & other_values)
        if overlap:
            matches.append((overlap, str(record.get("name", "")), record))
    matches.sort(key=lambda item: (-item[0], item[1].lower()))
    return [record for _, _, record in matches[:limit]]


def explicit_harness_relations(
    harness_id: str, relationships: list[dict], record_by_id: dict[str, dict]
) -> list[dict]:
    relevant = []
    for relation in relationships:
        if str(relation.get("from", "")) != harness_id:
            continue
        target = str(relation.get("to", ""))
        if target not in record_by_id:
            continue
        relevant.append(relation)
    return relevant


def related_explorations_for_harness(record: dict, explorations: list[dict]) -> list[dict]:
    harness_id = str(record.get("id", ""))
    concept_ids = set(str(value) for value in record.get("related_concepts", []))
    matches = []
    for exploration in explorations:
        meta = exploration.get("metadata", {})
        related_harnesses = set(str(value) for value in meta.get("related_harnesses", []))
        related_concepts = set(str(value) for value in meta.get("related_concepts", []))
        if harness_id in related_harnesses or concept_ids & related_concepts:
            matches.append(exploration)
    return matches


def related_explorations_for_concept(concept_id: str, explorations: list[dict]) -> list[dict]:
    matches = []
    for exploration in explorations:
        meta = exploration.get("metadata", {})
        related_concepts = set(str(value) for value in meta.get("related_concepts", []))
        if concept_id in related_concepts:
            matches.append(exploration)
    return matches


def related_explorations_for_browse_entry(
    field_key: str, entry: dict, explorations: list[dict]
) -> list[dict]:
    wanted = {entry["slug"], slugify(entry["label"])}
    wanted.update(ENTRY_EXPLORATION_ALIASES.get((field_key, entry["slug"]), []))
    wanted.update(
        ENTRY_EXPLORATION_ALIASES.get((field_key, slugify(entry["label"])), [])
    )
    matches = []
    for exploration in explorations:
        if Path(exploration["path"]).stem in wanted:
            matches.append(exploration)
    return matches


def build_browse_catalog(records: list[dict]) -> dict[str, list[dict]]:
    catalog: dict[str, list[dict]] = {}
    for field_key, config in BROWSE_FIELDS.items():
        entries_by_label: dict[str, dict] = {}
        for record in records:
            if config["kind"] == "summary":
                hidden_bet = record.get("hidden_bet", {})
                label = str(hidden_bet.get("summary", "")).strip()
                if not label:
                    continue
                entry = entries_by_label.setdefault(
                    label,
                    {
                        "label": label,
                        "notes": [],
                        "harnesses": [],
                    },
                )
                for note in hidden_bet.get("notes", []):
                    note_value = str(note).strip()
                    if note_value and note_value not in entry["notes"]:
                        entry["notes"].append(note_value)
                entry["harnesses"].append(record)
            else:
                for value in record.get(field_key, []):
                    label = str(value).strip()
                    if not label:
                        continue
                    entry = entries_by_label.setdefault(
                        label,
                        {
                            "label": label,
                            "notes": [],
                            "harnesses": [],
                        },
                    )
                    entry["harnesses"].append(record)

        used_slugs: set[str] = set()
        entries: list[dict] = []
        for label, entry in entries_by_label.items():
            base_slug = slugify(label)
            slug = base_slug
            counter = 2
            while slug in used_slugs:
                slug = f"{base_slug}-{counter}"
                counter += 1
            used_slugs.add(slug)
            entry["slug"] = slug
            entries.append(entry)
        entries.sort(key=lambda item: (-len(item["harnesses"]), item["label"].lower()))
        catalog[field_key] = entries
    return catalog


def browse_detail_output_href(
    field_key: str, label: str, catalog: dict[str, list[dict]]
) -> str:
    for entry in catalog[field_key]:
        if entry["label"] == label:
            return f"browse/{BROWSE_FIELDS[field_key]['slug']}/{entry['slug']}.html"
    return browse_index_output_href(field_key)


def render_concept_links(
    values: list[str], concepts: dict[str, dict], current_output_href: str
) -> str:
    items = []
    for value in values:
        concept_id = str(value)
        concept = concepts.get(concept_id, {})
        label = escape(str(concept.get("name", slug_to_label(concept_id))))
        items.append(
            f'<li><a class="pill" href="{concept_site_href(current_output_href, concept_id)}">{label}</a></li>'
        )
    return f"<ul class=\"pill-list\">{''.join(items)}</ul>"


def render_list(values: list[str]) -> str:
    items = "".join(f"<li>{escape(str(value))}</li>" for value in values)
    return f"<ul>{items}</ul>"


def render_browseable_list(
    values: list[str], field_key: str, catalog: dict[str, list[dict]], current_output_href: str
) -> str:
    items = []
    for value in values:
        label = str(value)
        href = relative_site_href(
            current_output_href, browse_detail_output_href(field_key, label, catalog)
        )
        items.append(f'<li><a href="{href}">{escape(label)}</a></li>')
    return f"<ul>{''.join(items)}</ul>"


