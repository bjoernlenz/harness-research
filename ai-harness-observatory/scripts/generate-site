#!/usr/bin/env python3

from __future__ import annotations

from html import escape
from pathlib import Path

import yaml


ROOT = Path(__file__).resolve().parent.parent
HARNESS_DIR = ROOT / "data" / "harnesses"
CONCEPT_DIR = ROOT / "data" / "concepts"
RELATIONSHIPS_PATH = ROOT / "data" / "relationships.yaml"
OUTPUT_PATH = ROOT / "site" / "index.html"
CONCEPT_OUTPUT_DIR = ROOT / "site" / "concepts"
MISSING_METAPHOR_PICTURES: set[str] = set()


def load_records() -> list[dict]:
    records = []
    for path in sorted(HARNESS_DIR.glob("*.yaml")):
        if path.name.startswith("_"):
            continue
        with path.open("r", encoding="utf-8") as handle:
            data = yaml.safe_load(handle) or {}
        if isinstance(data, dict):
            records.append(data)
    return records


def load_concepts() -> dict[str, dict]:
    concepts: dict[str, dict] = {}
    for path in sorted(CONCEPT_DIR.glob("*.yaml")):
        if path.name.startswith("_") or path.name == ".gitkeep":
            continue
        with path.open("r", encoding="utf-8") as handle:
            data = yaml.safe_load(handle) or {}
        if isinstance(data, dict) and "id" in data:
            concepts[str(data["id"])] = data
    return concepts


def load_relationships() -> list[dict]:
    with RELATIONSHIPS_PATH.open("r", encoding="utf-8") as handle:
        data = yaml.safe_load(handle) or {}
    relationships = data.get("relationships", [])
    return [item for item in relationships if isinstance(item, dict)]


def slug_to_label(value: str) -> str:
    return value.replace("-", " ").title()


def concept_href(concept_id: str) -> str:
    return f"concepts/{escape(concept_id)}.html"


def render_concept_links(values: list[str], concepts: dict[str, dict]) -> str:
    items = []
    for value in values:
        concept_id = str(value)
        concept = concepts.get(concept_id, {})
        label = escape(str(concept.get("name", slug_to_label(concept_id))))
        items.append(
            f'<li><a class="pill" href="{concept_href(concept_id)}">{label}</a></li>'
        )
    return f"<ul class=\"pill-list\">{''.join(items)}</ul>"


def render_list(values: list[str]) -> str:
    items = "".join(f"<li>{escape(str(value))}</li>" for value in values)
    return f"<ul>{items}</ul>"


