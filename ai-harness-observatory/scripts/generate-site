      </section>
      <section class="grid">
        {cards}
      </section>
      {more_stuff}
    </main>
  </body>
</html>
"""


def render_substrate_clusters(records: list[dict]) -> str:
    clusters: dict[str, list[str]] = {name: [] for name in SUBSTRATE_CLUSTERS}
    for record in records:
        name = escape(str(record.get("name", "Unknown")))
        href = harness_site_href(index_output_href(), str(record.get("id", "")))
        substrates = set(record.get("primary_substrate", []))
        for cluster_name, members in SUBSTRATE_CLUSTERS.items():
            if substrates & members:
                clusters[cluster_name].append(f'<a href="{href}">{name}</a>')
    parts = []
    for cluster_name, names in clusters.items():
        if not names:
            continue
        names_html = "".join(f"<li>{name}</li>" for name in names)
        parts.append(
            f'<article class="cluster"><h2><a class="section-link" href="{browse_index_output_href("primary_substrate")}">{escape(cluster_name)}</a></h2><ul>{names_html}</ul></article>'
        )
    return "".join(parts)


def render_concept_page(
    concept: dict,
    concepts: dict[str, dict],
    relationships: list[dict],
    record_by_id: dict[str, dict],
    explorations: list[dict],
) -> str:
    concept_id = str(concept.get("id", ""))
    name = escape(str(concept.get("name", slug_to_label(concept_id))))
    summary = escape(str(concept.get("summary", "")))
    note_path = NOTES_DIR / "concepts" / f"{concept_id}.md"
    concept_note_html = ""
    concept_links: list[str] = []
    if note_path.exists():
        note = load_markdown_note(str(note_path.relative_to(ROOT)))
        concept_links = extract_wikilinks(note["body"])
        note_body = strip_first_heading(note["body"]).strip()
        if note_body:
            concept_note_html = render_markdown_body(note_body)
    related_records = [
        record_by_id[harness_id]
        for harness_id in concept.get("related_harnesses", [])
        if harness_id in record_by_id
    ]
    current_output_href = concept_output_href(concept_id)
    related_harnesses = render_harness_links(related_records, current_output_href)
    inbound = []
    for relation in relationships:
        if str(relation.get("to", "")) != concept_id:
            continue
        source_id = str(relation.get("from", ""))
        if source_id in record_by_id:
            source_name = escape(str(record_by_id[source_id].get("name", slug_to_label(source_id))))
            source = f'<a href="{harness_site_href(current_output_href, source_id)}">{source_name}</a>'
        else:
            source = escape(slug_to_label(source_id))
        relation_name = escape(str(relation.get("relation", "")))
        note = escape(str(relation.get("note", "")))
        inbound.append(
            f"<li><strong>{source}</strong> <span class=\"relation-name\">{relation_name}</span><br><span class=\"relation-note\">{note}</span></li>"
        )
    inbound_html = (
        f"<ul class=\"relationship-list\">{''.join(inbound)}</ul>"
        if inbound
        else "<p class=\"empty-state\">No explicit relationships yet.</p>"
    )
    linked_concepts = []
    seen_related: set[str] = set()
    for linked in concept_links:
        if linked == concept_id or linked in seen_related or linked not in concepts:
            continue
        seen_related.add(linked)
        linked_concepts.append(
            (
                str(concepts[linked].get("name", slug_to_label(linked))),
                concept_site_href(concept_output_href(concept_id), linked),
            )
        )
    exploration_matches = related_explorations_for_concept(concept_id, explorations)
    grouped_explorations: dict[str, list[tuple[str, str]]] = {}
    for exploration in exploration_matches:
        group = exploration_kind_label(exploration)
        grouped_explorations.setdefault(group, []).append(
            (
                exploration["title"],
                relative_site_href(concept_output_href(concept_id), exploration["output_href"]),
            )
        )
    more_stuff = render_more_stuff(
        relative_site_href(current_output_href, index_output_href()), "../"
    )
    return f"""<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{name} · AI Harness Observatory</title>
    <style>
      :root {{
        color-scheme: light;
        --bg: #f5f1e8;
        --panel: #fffdf8;
        --ink: #1f1d1a;
        --muted: #6b655d;
        --accent: #a24d2c;
        --border: #d8cbb8;
      }}

      * {{
        box-sizing: border-box;
      }}

      body {{
        margin: 0;
        font-family: Georgia, "Times New Roman", serif;
        color: var(--ink);
        background:
          radial-gradient(circle at top left, rgba(162, 77, 44, 0.14), transparent 28%),
          linear-gradient(180deg, #f7f3eb 0%, var(--bg) 100%);
      }}

      main {{
        max-width: 860px;
        margin: 0 auto;
        padding: 48px 20px 64px;
      }}

      .back {{
        color: var(--accent);
        text-decoration: none;
      }}

      .panel {{
        margin-top: 22px;
        padding: 24px;
        border: 1px solid var(--border);
        border-radius: 18px;
        background: color-mix(in srgb, var(--panel) 92%, white 8%);
        box-shadow: 0 10px 30px rgba(44, 31, 18, 0.06);
      }}

      h1 {{
        margin: 10px 0 12px;
        font-size: clamp(2rem, 5vw, 3.2rem);
        line-height: 0.98;
      }}

      h2 {{
        margin: 22px 0 10px;
        color: var(--accent);
        font-size: 0.88rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
      }}

      p, ul {{
        line-height: 1.6;
      }}

      .relationship-list {{
        list-style: none;
        padding-left: 0;
      }}

      .relationship-list li {{
        padding: 10px 0;
        border-top: 1px solid rgba(216, 203, 184, 0.7);
      }}

      .relationship-list li:first-child {{
        border-top: 0;
        padding-top: 0;
      }}

      .relation-name {{
        color: var(--accent);
      }}

      .more-stuff {{
        margin-top: 22px;
        padding-top: 20px;
        border-top: 1px solid rgba(216, 203, 184, 0.7);
      }}

      .more-stuff-grid {{
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 16px;
      }}

      .more-stuff-group h3 {{
        margin: 0 0 8px;
      }}

      .more-stuff-group ul {{
        margin: 0;
        padding-left: 18px;
      }}

      .relation-note, .empty-state {{
        color: var(--muted);
      }}
    </style>
  </head>
  <body>
    <main>
      <a class="back" href="{relative_site_href(current_output_href, index_output_href())}">← Back to atlas</a>
      <div class="panel">
        <h1>{name}</h1>
        <p>{summary}</p>
        {'<h2>Concept Note</h2>' + concept_note_html if concept_note_html else ''}

        <h2>Related Harnesses</h2>
        {related_harnesses}

        <h2>Incoming Relationships</h2>
        {inbound_html}
        <h2>Explore This Concept</h2>
        <h3>Related Concepts</h3>
        {render_link_list(linked_concepts)}
        {''.join(f'<h3>{escape(group)}</h3>{render_link_list(items)}' for group, items in grouped_explorations.items())}
        {more_stuff}
      </div>
    </main>
  </body>
</html>
"""


def render_browse_hub(catalog: dict[str, list[dict]]) -> str:
