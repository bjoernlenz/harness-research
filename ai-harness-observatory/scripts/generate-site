  <circle cx="39" cy="42" r="2" fill="#1f1d1a"/>
  <circle cx="57" cy="42" r="2" fill="#1f1d1a"/>
  <path d="M41 54c4 3 10 3 14 0" fill="none" stroke="#1f1d1a" stroke-width="2.5" stroke-linecap="round"/>
  <path d="M24 70c4 6 8 8 12 8M72 70c-4 6-8 8-12 8" fill="none" stroke="#1f1d1a" stroke-width="3" stroke-linecap="round"/>
</svg>
""".strip()
    if key == "spider":
        return """
<svg viewBox="0 0 96 96" aria-hidden="true">
  <circle cx="48" cy="52" r="14" fill="#1f1d1a"/>
  <circle cx="48" cy="33" r="10" fill="#2f2d2a"/>
  <circle cx="43" cy="31" r="2" fill="#fffdf8"/>
  <circle cx="53" cy="31" r="2" fill="#fffdf8"/>
  <path d="M38 44 22 30M58 44 74 30M36 52 18 46M60 52 78 46M37 60 22 70M59 60 74 70" fill="none" stroke="#1f1d1a" stroke-width="3" stroke-linecap="round"/>
  <path d="M42 18 48 12 54 18" fill="none" stroke="#8b8177" stroke-width="2.5" stroke-linecap="round"/>
  <path d="M48 18v10" fill="none" stroke="#8b8177" stroke-width="2.5" stroke-linecap="round"/>
</svg>
""".strip()
    if key == "beaver":
        return """
<svg viewBox="0 0 96 96" aria-hidden="true">
  <ellipse cx="48" cy="51" rx="24" ry="22" fill="#8c6546"/>
  <circle cx="37" cy="45" r="4" fill="#1f1d1a"/>
  <circle cx="59" cy="45" r="4" fill="#1f1d1a"/>
  <ellipse cx="48" cy="58" rx="10" ry="8" fill="#d9b38c"/>
  <rect x="43" y="58" width="4" height="10" rx="1" fill="#fff5dc" stroke="#1f1d1a" stroke-width="1.5"/>
  <rect x="49" y="58" width="4" height="10" rx="1" fill="#fff5dc" stroke="#1f1d1a" stroke-width="1.5"/>
  <path d="M28 66c-8 3-11 8-9 14 6-1 11-2 16-6" fill="#6f4f34" stroke="#1f1d1a" stroke-width="2.5" stroke-linejoin="round"/>
  <path d="M38 69c6 3 14 3 20 0" fill="none" stroke="#1f1d1a" stroke-width="2.5" stroke-linecap="round"/>
</svg>
""".strip()
    if label.strip():
        MISSING_METAPHOR_PICTURES.add(label.strip())
    return """
<svg viewBox="0 0 96 96" aria-hidden="true">
  <circle cx="48" cy="48" r="32" fill="#f0e2cc" stroke="#1f1d1a" stroke-width="4"/>
  <path d="M34 57c8-6 20-6 28 0" fill="none" stroke="#c87745" stroke-width="4" stroke-linecap="round"/>
  <circle cx="39" cy="39" r="4" fill="#1f1d1a"/>
  <circle cx="57" cy="39" r="4" fill="#1f1d1a"/>
</svg>
""".strip()


def metaphor_label(metaphor: dict) -> str:
    animal = metaphor.get("animal")
    transport = metaphor.get("transport")
    if animal:
        return str(animal)
    if transport:
        return str(transport)
    return ""


def render_section_heading(label: str, field_key: str | None = None) -> str:
    if field_key is None:
        return f"<h3>{escape(label)}</h3>"
    return (
        f'<h3><a class="section-link" href="{browse_index_output_href(field_key)}">'
        f"{escape(label)}</a></h3>"
    )


def render_more_stuff(index_href: str, repo_prefix: str) -> str:
    sections = []
    sections.append(
        f"""
        <section class="more-stuff-group">
          <h3>Index</h3>
          <ul><li><a href="{escape(index_href)}">Back to index</a></li></ul>
        </section>
        """.rstrip()
    )
    for heading, paths in MORE_STUFF.items():
        items = []
        for path in paths:
            label = note_link_label(path)
            items.append(
                f'<li><a href="{repo_prefix}{escape(note_output_href(path))}">{escape(label)}</a></li>'
            )
        sections.append(
            f"""
        <section class="more-stuff-group">
          <h3>{escape(heading)}</h3>
          <ul>{''.join(items)}</ul>
        </section>
            """.rstrip()
        )
    return f"""
      <footer class="more-stuff">
        <h2>More Stuff</h2>
        <p class="subtle">Generated views are the atlas surface. These notes carry synthesis, comparison, and review context.</p>
        <div class="more-stuff-grid">
          {''.join(sections)}
        </div>
      </footer>
    """.rstrip()


def render_inline_markdown(text: str) -> str:
    escaped = escape(text)
    escaped = re.sub(r"\[\[([^\]]+)\]\]", lambda m: slug_to_label(m.group(1)), escaped)
    escaped = re.sub(r"`([^`]+)`", r"<code>\1</code>", escaped)
    escaped = re.sub(r"\*\*([^*]+)\*\*", r"<strong>\1</strong>", escaped)
    escaped = re.sub(r"\*([^*]+)\*", r"<em>\1</em>", escaped)
    return escaped


def render_markdown_body(markdown_text: str) -> str:
    lines = markdown_text.splitlines()
    html_parts: list[str] = []
    in_list = False
    in_blockquote = False
    paragraph_lines: list[str] = []

    def flush_paragraph() -> None:
        nonlocal paragraph_lines
        if paragraph_lines:
            content = " ".join(line.strip() for line in paragraph_lines).strip()
            if content:
                html_parts.append(f"<p>{render_inline_markdown(content)}</p>")
            paragraph_lines = []

    def close_list() -> None:
        nonlocal in_list
        if in_list:
            html_parts.append("</ul>")
            in_list = False

    def close_blockquote() -> None:
        nonlocal in_blockquote
        if in_blockquote:
            flush_paragraph()
            close_list()
            html_parts.append("</blockquote>")
            in_blockquote = False

    for raw_line in lines:
        line = raw_line.rstrip()
        stripped = line.strip()

        if not stripped:
            flush_paragraph()
            close_list()
            close_blockquote()
            continue

        if stripped.startswith("> "):
            flush_paragraph()
            close_list()
            if not in_blockquote:
                html_parts.append("<blockquote>")
                in_blockquote = True
            paragraph_lines.append(stripped[2:])
            continue
        else:
            close_blockquote()

        heading_match = re.match(r"^(#{1,6})\s+(.*)$", stripped)
        if heading_match:
            flush_paragraph()
            close_list()
            level = len(heading_match.group(1))
            content = render_inline_markdown(heading_match.group(2).strip())
            html_parts.append(f"<h{level}>{content}</h{level}>")
            continue

        if stripped.startswith("- "):
            flush_paragraph()
            if not in_list:
                html_parts.append("<ul>")
                in_list = True
            html_parts.append(f"<li>{render_inline_markdown(stripped[2:].strip())}</li>")
            continue

        numbered_match = re.match(r"^\d+\.\s+(.*)$", stripped)
        if numbered_match:
            flush_paragraph()
            if not in_list:
                html_parts.append("<ul>")
                in_list = True
            html_parts.append(
                f"<li>{render_inline_markdown(numbered_match.group(1).strip())}</li>"
            )
            continue

        paragraph_lines.append(stripped)

    flush_paragraph()
    close_list()
    close_blockquote()
    return "\n".join(html_parts)


def render_note_page(
    note_path: str,
    concepts: dict[str, dict],
    record_by_id: dict[str, dict],
    explorations: list[dict],
    note_registry: dict[str, dict],
) -> str:
    note = load_markdown_note(note_path)
    title = note["title"]
    body_html = render_markdown_body(note["body"])
    section = note["section"].replace("/", " / ").replace("-", " ").title()
    note_output = note["output_href"]
    back_href = relative_site_href(note_output, index_output_href())
    metadata = note.get("metadata", {})
    threads_html = ""
    if str(metadata.get("kind", "")).strip():
        harness_links = [
            (
                str(record_by_id[h_id].get("name", slug_to_label(h_id))),
                harness_site_href(note_output, h_id),
            )
            for h_id in metadata.get("related_harnesses", [])
            if h_id in record_by_id
        ]
        concept_links = [
            (
                str(concepts[c_id].get("name", slug_to_label(c_id))),
                concept_site_href(note_output, c_id),
            )
            for c_id in metadata.get("related_concepts", [])
            if c_id in concepts
        ]
        exploration_lookup = {exploration["id"]: exploration for exploration in explorations}
        tension_links = [
            (
                exploration_lookup[key]["title"],
                relative_site_href(note_output, exploration_lookup[key]["output_href"]),
            )
            for key in metadata.get("related_tensions", [])
            if key in exploration_lookup
        ]
        history_links = [
            (
                exploration_lookup[key]["title"],
                relative_site_href(note_output, exploration_lookup[key]["output_href"]),
            )
            for key in metadata.get("related_histories", [])
            if key in exploration_lookup
        ]
        comparison_lookup = {
            note_id: note
            for note_id, note in note_registry.items()
            if str(note.get("metadata", {}).get("kind", "")).strip() == "comparison"
        }
        comparison_links = [
            (
                comparison_lookup[key]["title"],
                relative_site_href(note_output, comparison_lookup[key]["output_href"]),
            )
            for key in metadata.get("related_comparisons", [])
            if key in comparison_lookup
        ]
        threads_html = f"""
        <div class="threads">
          <h2>Further Threads</h2>
          <h3>Related Harnesses</h3>
          {render_link_list(harness_links)}
          <h3>Related Concepts</h3>
          {render_link_list(concept_links)}
          <h3>Tensions</h3>
          {render_link_list(tension_links)}
          <h3>Historical Notes</h3>
          {render_link_list(history_links)}
          <h3>Comparisons</h3>
          {render_link_list(comparison_links)}
        </div>
        """.rstrip()
    return f"""<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{escape(title)} · AI Harness Observatory</title>
    <style>
      :root {{
        color-scheme: light;
        --bg: #f5f1e8;
        --panel: #fffdf8;
        --ink: #1f1d1a;
        --muted: #6b655d;
        --accent: #a24d2c;
        --border: #d8cbb8;
      }}
      * {{ box-sizing: border-box; }}
      body {{
        margin: 0;
        font-family: Georgia, "Times New Roman", serif;
        color: var(--ink);
        background:
          radial-gradient(circle at top left, rgba(162, 77, 44, 0.14), transparent 28%),
          linear-gradient(180deg, #f7f3eb 0%, var(--bg) 100%);
      }}
      main {{ max-width: 860px; margin: 0 auto; padding: 48px 20px 64px; }}
      .back {{ color: var(--accent); text-decoration: none; }}
      .panel {{
        margin-top: 22px;
        padding: 24px;
        border: 1px solid var(--border);
        border-radius: 18px;
        background: color-mix(in srgb, var(--panel) 92%, white 8%);
        box-shadow: 0 10px 30px rgba(44, 31, 18, 0.06);
      }}
      .eyebrow {{
        margin: 0 0 8px;
        color: var(--accent);
        font-size: 0.88rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
      }}
      h1 {{
        margin: 0 0 18px;
        font-size: clamp(2rem, 5vw, 3.2rem);
        line-height: 0.98;
      }}
      h2, h3, h4, h5, h6 {{
        margin: 24px 0 10px;
        color: var(--accent);
      }}
      p, ul, blockquote {{
        line-height: 1.7;
      }}
      blockquote {{
        margin: 18px 0;
        padding-left: 16px;
        border-left: 3px solid var(--border);
        color: var(--muted);
      }}
      code {{
        padding: 1px 5px;
        border-radius: 6px;
        background: #efe2cf;
        font-size: 0.95em;
      }}
      .threads {{
        margin-top: 28px;
        padding-top: 20px;
        border-top: 1px solid rgba(216, 203, 184, 0.7);
      }}
    </style>
  </head>
  <body>
    <main>
      <a class="back" href="{back_href}">← Back to atlas</a>
      <div class="panel">
        <p class="eyebrow">{escape(section)}</p>
        {body_html}
        {threads_html}
      </div>
    </main>
  </body>
</html>
"""


def render_relationships(
    current_output_href: str,
    harness_id: str,
    relationships: list[dict],
    concepts: dict[str, dict],
    record_by_id: dict[str, dict],
) -> str:
    items = []
    for relation in relationships:
        if str(relation.get("from", "")) != harness_id:
            continue
        relation_name = escape(str(relation.get("relation", "")))
        target = str(relation.get("to", ""))
        target_concept = concepts.get(target)
        if target_concept:
            target_label = escape(str(target_concept.get("name", slug_to_label(target))))
            target_html = f'<a href="{concept_site_href(current_output_href, target)}">{target_label}</a>'
        elif target in record_by_id:
            target_label = escape(str(record_by_id[target].get("name", slug_to_label(target))))
            target_html = f'<a href="{harness_site_href(current_output_href, target)}">{target_label}</a>'
        else:
            target_html = escape(slug_to_label(target))
        note = escape(str(relation.get("note", "")))
        items.append(
            f"<li><strong>{relation_name}</strong> → {target_html}<br><span class=\"relation-note\">{note}</span></li>"
        )
    if not items:
        return ""
    return f"""
      <section>
        {render_section_heading("Relationships")}
        <ul class="relationship-list">{''.join(items)}</ul>
      </section>
    """.rstrip()


def render_card(
    current_output_href: str,
    record: dict,
    records: list[dict],
    concepts: dict[str, dict],
    relationships: list[dict],
    catalog: dict[str, list[dict]],
    record_by_id: dict[str, dict],
    explorations: list[dict],
) -> str:
    harness_id = str(record.get("id", ""))
    name = escape(str(record.get("name", "Unknown")))
    worldview = escape(str(record.get("worldview", {}).get("short", "")))
    category = render_list(record.get("category", []))
    architectural_core = render_list(record.get("architectural_core", []))
    complexity_focus = render_list(record.get("complexity_focus", []))
    primary_substrate = render_browseable_list(
        record.get("primary_substrate", []), "primary_substrate", catalog, current_output_href
    )
    cognitive_style = render_browseable_list(
        record.get("cognitive_style", []), "cognitive_style", catalog, current_output_href
    )
    trust_model = render_browseable_list(
        record.get("trust_model", []), "trust_model", catalog, current_output_href
    )
    failure_modes = render_browseable_list(
        record.get("failure_modes", []), "failure_modes", catalog, current_output_href
    )
    representative_for = render_browseable_list(
        record.get("representative_for", []), "representative_for", catalog, current_output_href
    )
    related_concepts = render_concept_links(record.get("related_concepts", []), concepts, current_output_href)
    playfulness = escape(str(record.get("playfulness", {}).get("summary", "")))
    metaphor = record.get("metaphor", {})
    metaphor_name = escape(metaphor_label(metaphor))
    metaphor_rationale = escape(str(metaphor.get("rationale", "")))
    metaphor_picture = render_metaphor_picture(metaphor_label(metaphor))
    what_it_refuses = render_list(record.get("what_it_refuses", []))
    core_tension = escape(str(record.get("core_tension", "")))
    hidden_bet = record.get("hidden_bet", {})
    hidden_bet_summary = escape(str(hidden_bet.get("summary", "")))
    hidden_bet_href = relative_site_href(current_output_href, browse_detail_output_href(
        "hidden_bet", str(hidden_bet.get("summary", "")), catalog
    ))
    relationships_html = render_relationships(
        current_output_href, harness_id, relationships, concepts, record_by_id
    )
    shared_substrate = render_harness_links(
        top_related_harnesses(record, records, "primary_substrate"), current_output_href
    )
    shared_trust = render_harness_links(
        top_related_harnesses(record, records, "trust_model"), current_output_href
    )
    shared_style = render_harness_links(
        top_related_harnesses(record, records, "cognitive_style"), current_output_href
    )
    contrast_items = []
    for relation in explicit_harness_relations(harness_id, relationships, record_by_id):
        if str(relation.get("relation", "")) not in {
            "contrasts_with",
            "different_complexity_center_than",
            "contrasts_cognitive_style_with",
            "opposes_hidden_bet_of",
            "competes_for_same_use_case_as",
        }:
            continue
        target = str(relation.get("to", ""))
        target_record = record_by_id.get(target)
        if target_record:
            contrast_items.append(
                (str(target_record.get("name", slug_to_label(target))), harness_site_href(current_output_href, target))
            )
    related_explorations = related_explorations_for_harness(record, explorations)
    grouped_explorations: dict[str, list[tuple[str, str]]] = {}
    for exploration in related_explorations:
        group = exploration_kind_label(exploration)
        grouped_explorations.setdefault(group, []).append(
            (exploration["title"], relative_site_href(current_output_href, exploration["output_href"]))
        )
    metaphor_html = ""
    if metaphor_name:
        metaphor_html = f"""
      <section>
        {render_section_heading("Animal or Transport")}
        <p><strong>{metaphor_name}</strong></p>
        <p>{metaphor_rationale}</p>
      </section>
        """.rstrip()

    return f"""
    <article class="card" id="{escape(harness_id)}">
      <div class="metaphor-picture" title="{metaphor_name}">
        {metaphor_picture}
      </div>
      <h2>{name}</h2>
      <section>
        {render_section_heading("Category")}
        {category}
      </section>
      <section>
        {render_section_heading("Architectural Core")}
        {architectural_core}
      </section>
      <section>
        {render_section_heading("Worldview")}
        <p>{worldview}</p>
      </section>
      <section>
        {render_section_heading("Complexity Focus")}
        {complexity_focus}
      </section>
      <section>
        {render_section_heading("Primary Substrate", "primary_substrate")}
        {primary_substrate}
      </section>
      <section>
        {render_section_heading("Cognitive Style", "cognitive_style")}
        {cognitive_style}
      </section>
      <section>
        {render_section_heading("Trust Model", "trust_model")}
        {trust_model}
      </section>
      <section>
        {render_section_heading("Hidden Bet", "hidden_bet")}
        <p><a href="{hidden_bet_href}">{hidden_bet_summary}</a></p>
      </section>
      <section>
        {render_section_heading("Playfulness")}
        <p>{playfulness}</p>
      </section>
      <section>
        {render_section_heading("Failure Modes", "failure_modes")}
        {failure_modes}
      </section>
      <section>
        {render_section_heading("What It Refuses")}
        {what_it_refuses}
      </section>
      <section>
        {render_section_heading("Core Tension")}
        <p>{core_tension}</p>
      </section>
      <section>
        {render_section_heading("Representative For", "representative_for")}
        {representative_for}
      </section>
      {metaphor_html}
      <section>
        {render_section_heading("Related Concepts")}
        {related_concepts}
      </section>
      {relationships_html}
      <section>
        {render_section_heading("More To Explore")}
        <h4>Shares Primary Substrate</h4>
        {shared_substrate}
        <h4>Shares Trust Model</h4>
        {shared_trust}
        <h4>Shares Cognitive Style</h4>
        {shared_style}
        <h4>Contrasts With</h4>
        {render_link_list(contrast_items)}
        {''.join(f'<h4>{escape(group)}</h4>{render_link_list(items)}' for group, items in grouped_explorations.items())}
      </section>
    </article>
    """.strip()


def render_browse_nav() -> str:
    items = []
    for field_key, config in BROWSE_FIELDS.items():
        items.append(
            f'<li><a class="pill" href="{browse_index_output_href(field_key)}">{escape(config["label"])}</a></li>'
        )
    items.append('<li><a class="pill" href="browse/index.html">Browse Hub</a></li>')
    return f"<ul class=\"pill-list\">{''.join(items)}</ul>"


