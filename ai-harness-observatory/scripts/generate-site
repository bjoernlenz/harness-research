            current_output_href, browse_index_output_href(field_key)
        )
        cards.append(
            f"""
      <article class="panel">
        <h2><a class="back" href="{href}">{escape(config["label"])}</a></h2>
        <p>{len(catalog[field_key])} generated entries available for browsing.</p>
      </article>
            """.rstrip()
        )
    more_stuff = render_more_stuff(
        relative_site_href(current_output_href, index_output_href()), "../"
    )
    return f"""<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Browse Hub · AI Harness Observatory</title>
    <style>
      :root {{
        color-scheme: light;
        --bg: #f5f1e8;
        --panel: #fffdf8;
        --ink: #1f1d1a;
        --muted: #6b655d;
        --accent: #a24d2c;
        --border: #d8cbb8;
      }}
      * {{ box-sizing: border-box; }}
      body {{
        margin: 0;
        font-family: Georgia, "Times New Roman", serif;
        color: var(--ink);
        background:
          radial-gradient(circle at top left, rgba(162, 77, 44, 0.14), transparent 28%),
          linear-gradient(180deg, #f7f3eb 0%, var(--bg) 100%);
      }}
      main {{ max-width: 960px; margin: 0 auto; padding: 48px 20px 64px; }}
      .grid {{ display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; }}
      .panel {{
        padding: 20px;
        border: 1px solid var(--border);
        border-radius: 16px;
