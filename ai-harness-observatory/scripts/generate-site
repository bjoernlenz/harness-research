def render_browse_index_page(field_key: str, entries: list[dict]) -> str:
    config = BROWSE_FIELDS[field_key]
    current_output_href = browse_index_output_href(field_key)
    items = []
    for entry in entries:
        href = relative_site_href(
            current_output_href,
            f"browse/{BROWSE_FIELDS[field_key]['slug']}/{entry['slug']}.html",
        )
        count = len(entry["harnesses"])
        items.append(
            f"""
        <li>
          <a href="{href}">{escape(entry["label"])}</a>
          <span class="count">{count}</span>
        </li>
            """.rstrip()
        )
    more_stuff = render_more_stuff(
        relative_site_href(current_output_href, index_output_href()), "../../"
    )
    return f"""<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{escape(config["label"])} · AI Harness Observatory</title>
    <style>
      :root {{
        color-scheme: light;
        --bg: #f5f1e8;
        --panel: #fffdf8;
        --ink: #1f1d1a;
        --muted: #6b655d;
        --accent: #a24d2c;
        --border: #d8cbb8;
      }}
      * {{ box-sizing: border-box; }}
      body {{
        margin: 0;
        font-family: Georgia, "Times New Roman", serif;
        color: var(--ink);
        background:
          radial-gradient(circle at top left, rgba(162, 77, 44, 0.14), transparent 28%),
          linear-gradient(180deg, #f7f3eb 0%, var(--bg) 100%);
      }}
      main {{ max-width: 920px; margin: 0 auto; padding: 48px 20px 64px; }}
      .back {{ color: var(--accent); text-decoration: none; }}
      h1 {{ margin: 10px 0 12px; font-size: clamp(2rem, 5vw, 3.2rem); line-height: 0.98; }}
      p {{ line-height: 1.6; color: var(--muted); max-width: 60ch; }}
      .panel {{
        margin-top: 22px;
        padding: 24px;
        border: 1px solid var(--border);
        border-radius: 18px;
        background: color-mix(in srgb, var(--panel) 92%, white 8%);
      }}
      .browse-list {{ list-style: none; padding-left: 0; margin: 0; }}
      .browse-list li {{
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 18px;
        padding: 12px 0;
        border-top: 1px solid rgba(216, 203, 184, 0.7);
      }}
      .browse-list li:first-child {{ border-top: 0; padding-top: 0; }}
      a {{ color: var(--ink); }}
      .count {{
        color: var(--accent);
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
      }}
      .more-stuff {{
        margin-top: 30px;
        padding: 22px;
        border: 1px solid var(--border);
        border-radius: 16px;
        background: color-mix(in srgb, var(--panel) 92%, white 8%);
      }}
      .more-stuff-grid {{
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 16px;
      }}
      .more-stuff-group ul {{
        margin: 0;
        padding-left: 18px;
      }}
    </style>
  </head>
  <body>
    <main>
      <a class="back" href="{relative_site_href(current_output_href, index_output_href())}">← Back to atlas</a>
      <h1>{escape(config["label"])}</h1>
      <p>Generated from canonical YAML records and sorted by how many harnesses currently express each entry.</p>
      <div class="panel">
        <ul class="browse-list">
          {''.join(items)}
        </ul>
      </div>
      {more_stuff}
    </main>
  </body>
</html>
"""


def render_browse_detail_page(
    field_key: str, entry: dict, explorations: list[dict]
) -> str:
    config = BROWSE_FIELDS[field_key]
    notes_html = ""
    if entry["notes"]:
        notes_html = f"""
      <h2>Why This Matters</h2>
      <ul>{''.join(f"<li>{escape(note)}</li>" for note in entry["notes"])}</ul>
        """.rstrip()
    current_output_href = f"browse/{BROWSE_FIELDS[field_key]['slug']}/{entry['slug']}.html"
    harnesses_html = render_harness_links(entry["harnesses"], current_output_href)
    related_explorations = related_explorations_for_browse_entry(
        field_key, entry, explorations
    )
    exploration_html = ""
    if related_explorations:
        items = []
        for exploration in related_explorations:
            paragraph = strip_first_heading(exploration["body"]).strip().split("\n\n", 1)[0]
            summary = render_inline_markdown(paragraph.replace("\n", " "))
            items.append(
                f"""
          <li>
            <a href="{escape(relative_site_href(current_output_href, exploration['output_href']))}">{escape(exploration['title'])}</a>
            <div class="subtle">{summary}</div>
          </li>
                """.rstrip()
            )
        exploration_html = f"""
        <h2>Further Threads</h2>
        <ul>{''.join(items)}</ul>
        """.rstrip()
    more_stuff = render_more_stuff(
        relative_site_href(current_output_href, index_output_href()), "../../"
    )
    return f"""<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{escape(entry["label"])} · {escape(config["label"])}</title>
    <style>
      :root {{
        color-scheme: light;
        --bg: #f5f1e8;
        --panel: #fffdf8;
        --ink: #1f1d1a;
        --muted: #6b655d;
        --accent: #a24d2c;
        --border: #d8cbb8;
      }}
      * {{ box-sizing: border-box; }}
      body {{
        margin: 0;
        font-family: Georgia, "Times New Roman", serif;
        color: var(--ink);
        background:
          radial-gradient(circle at top left, rgba(162, 77, 44, 0.14), transparent 28%),
          linear-gradient(180deg, #f7f3eb 0%, var(--bg) 100%);
      }}
      main {{ max-width: 860px; margin: 0 auto; padding: 48px 20px 64px; }}
      .back {{ color: var(--accent); text-decoration: none; }}
      .panel {{
        margin-top: 22px;
        padding: 24px;
        border: 1px solid var(--border);
        border-radius: 18px;
        background: color-mix(in srgb, var(--panel) 92%, white 8%);
      }}
      h1 {{ margin: 10px 0 12px; font-size: clamp(2rem, 5vw, 3.2rem); line-height: 0.98; }}
      h2 {{
        margin: 22px 0 10px;
        color: var(--accent);
        font-size: 0.88rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
      }}
      p, ul {{ line-height: 1.6; }}
      .more-stuff {{
        margin-top: 22px;
        padding-top: 20px;
        border-top: 1px solid rgba(216, 203, 184, 0.7);
      }}
      .more-stuff-grid {{
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 16px;
      }}
      .more-stuff-group ul {{
        margin: 0;
        padding-left: 18px;
      }}
    </style>
  </head>
  <body>
    <main>
      <a class="back" href="{relative_site_href(current_output_href, browse_index_output_href(field_key))}">← Back to {escape(config["label"]).lower()}</a>
      <div class="panel">
        <h1>{escape(entry["label"])}</h1>
        <p>{len(entry["harnesses"])} harnesses currently express this entry.</p>
        {notes_html}
        {exploration_html}
        <h2>Harnesses</h2>
        {harnesses_html}
        {more_stuff}
      </div>
    </main>
  </body>
</html>
"""


def main() -> int:
    MISSING_METAPHOR_PICTURES.clear()
    records = load_records()
    record_by_id = {str(record.get("id", "")): record for record in records}
    concepts = load_concepts()
    relationships = load_relationships()
    explorations = load_explorations()
    note_registry = load_note_registry(explorations)
    catalog = build_browse_catalog(records)
    OUTPUT_PATH.write_text(
        render_page(
            records, concepts, relationships, catalog, record_by_id, explorations
        ),
        encoding="utf-8",
    )
    CONCEPT_OUTPUT_DIR.mkdir(parents=True, exist_ok=True)
    for concept_id, concept in concepts.items():
        concept_path = CONCEPT_OUTPUT_DIR / f"{concept_id}.html"
        concept_path.write_text(
            render_concept_page(
                concept, concepts, relationships, record_by_id, explorations
            ),
            encoding="utf-8",
        )
    BROWSE_OUTPUT_DIR.mkdir(parents=True, exist_ok=True)
    NOTES_OUTPUT_DIR.mkdir(parents=True, exist_ok=True)
    (BROWSE_OUTPUT_DIR / "index.html").write_text(
        render_browse_hub(catalog), encoding="utf-8"
    )
    for field_key, entries in catalog.items():
        field_dir = BROWSE_OUTPUT_DIR / BROWSE_FIELDS[field_key]["slug"]
        field_dir.mkdir(parents=True, exist_ok=True)
        (field_dir / "index.html").write_text(
            render_browse_index_page(field_key, entries), encoding="utf-8"
        )
        for entry in entries:
            (field_dir / f"{entry['slug']}.html").write_text(
                render_browse_detail_page(field_key, entry, explorations),
                encoding="utf-8"
            )
    for section_paths in MORE_STUFF.values():
        for note_path in section_paths:
            output_path = NOTES_OUTPUT_DIR / Path(note_path).relative_to("notes")
            output_path = output_path.with_suffix(".html")
            output_path.parent.mkdir(parents=True, exist_ok=True)
            output_path.write_text(
                render_note_page(
                    note_path, concepts, record_by_id, explorations, note_registry
                ),
                encoding="utf-8",
            )
    print(f"Wrote {OUTPUT_PATH}")
    if MISSING_METAPHOR_PICTURES:
        missing = ", ".join(sorted(MISSING_METAPHOR_PICTURES))
        print(f"Reminder: add dedicated metaphor pictures for: {missing}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
