def metaphor_label(metaphor: dict) -> str:
    animal = metaphor.get("animal")
    transport = metaphor.get("transport")
    if animal:
        return str(animal)
    if transport:
        return str(transport)
    return ""


def render_relationships(harness_id: str, relationships: list[dict], concepts: dict[str, dict]) -> str:
    items = []
    for relation in relationships:
        if str(relation.get("from", "")) != harness_id:
            continue
        relation_name = escape(str(relation.get("relation", "")))
        target = str(relation.get("to", ""))
        target_concept = concepts.get(target)
        if target_concept:
            target_label = escape(str(target_concept.get("name", slug_to_label(target))))
            target_html = f'<a href="{concept_href(target)}">{target_label}</a>'
        else:
            target_html = escape(slug_to_label(target))
        note = escape(str(relation.get("note", "")))
        items.append(
            f"<li><strong>{relation_name}</strong> → {target_html}<br><span class=\"relation-note\">{note}</span></li>"
        )
    if not items:
        return ""
    return f"""
      <section>
        <h3>Relationships</h3>
        <ul class="relationship-list">{''.join(items)}</ul>
      </section>
    """.rstrip()


def render_card(record: dict, concepts: dict[str, dict], relationships: list[dict]) -> str:
    harness_id = str(record.get("id", ""))
    name = escape(str(record.get("name", "Unknown")))
    worldview = escape(str(record.get("worldview", {}).get("short", "")))
    category = render_list(record.get("category", []))
    architectural_core = render_list(record.get("architectural_core", []))
    complexity_focus = render_list(record.get("complexity_focus", []))
    primary_substrate = render_list(record.get("primary_substrate", []))
    trust_model = render_list(record.get("trust_model", []))
    failure_modes = render_list(record.get("failure_modes", []))
    representative_for = render_list(record.get("representative_for", []))
    related_concepts = render_concept_links(record.get("related_concepts", []), concepts)
    playfulness = escape(str(record.get("playfulness", {}).get("summary", "")))
    metaphor = record.get("metaphor", {})
    metaphor_name = escape(metaphor_label(metaphor))
    metaphor_rationale = escape(str(metaphor.get("rationale", "")))
    metaphor_picture = render_metaphor_picture(metaphor_label(metaphor))
    what_it_refuses = render_list(record.get("what_it_refuses", []))
    core_tension = escape(str(record.get("core_tension", "")))
    relationships_html = render_relationships(harness_id, relationships, concepts)
    metaphor_html = ""
    if metaphor_name:
        metaphor_html = f"""
      <section>
        <h3>Animal or Transport</h3>
        <p><strong>{metaphor_name}</strong></p>
        <p>{metaphor_rationale}</p>
      </section>
        """.rstrip()

    return f"""
    <article class="card">
      <div class="metaphor-picture" title="{metaphor_name}">
        {metaphor_picture}
      </div>
      <h2>{name}</h2>
      <section>
        <h3>Category</h3>
        {category}
      </section>
      <section>
        <h3>Architectural Core</h3>
        {architectural_core}
      </section>
      <section>
        <h3>Worldview</h3>
        <p>{worldview}</p>
      </section>
      <section>
        <h3>Complexity Focus</h3>
        {complexity_focus}
      </section>
      <section>
        <h3>Primary Substrate</h3>
        {primary_substrate}
      </section>
      <section>
        <h3>Trust Model</h3>
        {trust_model}
      </section>
      <section>
        <h3>Playfulness</h3>
        <p>{playfulness}</p>
      </section>
      <section>
        <h3>Failure Modes</h3>
        {failure_modes}
      </section>
      <section>
        <h3>What It Refuses</h3>
        {what_it_refuses}
      </section>
      <section>
        <h3>Core Tension</h3>
        <p>{core_tension}</p>
      </section>
      <section>
        <h3>Representative For</h3>
        {representative_for}
      </section>
      {metaphor_html}
      <section>
        <h3>Related Concepts</h3>
        {related_concepts}
      </section>
      {relationships_html}
    </article>
    """.strip()


